{
  "type": "object",
  "properties": {
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "slot_id",
          "top_family",
          "family",
          "intent_route",
          "rationale",
          "musts",
          "embedding_query",
          "bm25_query",
          "filters",
          "top_k"
        ],
        "properties": {
          "slot_id": { "type": "string" },

          "top_family": {
            "type": "string",
            "enum": [
              "Food/Nutrition",
              "Treats",
              "Toys/Chews",
              "Health & Wellness",
              "Flea & Tick",
              "Grooming/Hygiene",
              "Gear/Travel",
              "Leashes/Collars",
              "Apparel",
              "Feeding/Bowls",
              "Litter/Waste",
              "Cleaning",
              "Training/Tech",
              "RX/Prescription",
              "Seasonal/Environment",
              "Emergency/Safety",
              "Life Transitions",
              "Event/Travel"
            ]
          },

          "family": { "type": "string", "minLength": 1 },

          "intent_route": {
            "type": "string",
            "enum": [
              "food",
              "treats",
              "chew",
              "dental",
              "toys",
              "grooming",
              "gear",
              "feeding",
              "walking",
              "training",
              "cleaning",
              "health",
              "calming",
              "cooling",
              "winter_gear",
              "travel",
              "emergency",
              "seasonal",
              "safety",
              "other"
            ]
          },
          "intent_route_detail": { "type": "string" },

          "rationale": { "type": "string" },
          "musts": { "type": "array", "items": { "type": "string" } },
          "nice_to_haves": { "type": "array", "items": { "type": "string" } },
          "negatives": { "type": "array", "items": { "type": "string" } },

          "embedding_query": { "type": "string", "minLength": 200, "maxLength": 600 },
          "bm25_query": { "type": "string" },

          "filters": {
            "type": "object",
            "required": ["pc1"],
            "properties": {
              "pc1": { "type": "string" }
            },
            "additionalProperties": true
          },

          "top_k": { "type": "integer", "minimum": 10, "maximum": 200 },
          "brand_bias": { "type": "array", "items": { "type": "string" } },

          "evidence": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "additionalProperties": false
      }
    },

    "fusion": {
      "type": "object",
      "properties": {
        "strategy": { "type": "string", "enum": ["rrf", "weighted"] },
        "k": { "type": "integer" },
        "alpha_vector": { "type": "number" },
        "beta_bm25": { "type": "number" }
      },
      "required": ["strategy"]
    },

    "safety": {
      "type": "object",
      "properties": {
        "enforce_allergens": { "type": "boolean" },
        "species_lock": { "type": "boolean" }
      },
      "required": ["enforce_allergens", "species_lock"]
    }
  },
  "required": ["slots", "fusion", "safety"],
  "additionalProperties": false
}
