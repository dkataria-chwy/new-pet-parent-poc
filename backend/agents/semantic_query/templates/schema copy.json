{
  "type": "object",
  "properties": {
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "slot_id",
          "top_family",
          "family",
          "rationale",
          "musts",
          "negatives",
          "embedding_query",
          "bm25_query",
          "filters",
          "top_k"
        ],
        "properties": {
          "slot_id": { "type": "string" },

          "top_family": {
            "type": "string",
            "enum": [
              "Food/Nutrition",
              "Treats",
              "Toys/Chews",
              "Health & Wellness",
              "Flea & Tick",
              "Grooming/Hygiene",
              "Gear/Travel",
              "Leashes/Collars",
              "Apparel",
              "Feeding/Bowls",
              "Litter/Waste",
              "Cleaning",
              "Training/Tech",
              "RX/Prescription",
              "Seasonal/Environment",
              "Emergency/Safety",
              "Life Transitions",
              "Event/Travel"
            ]
          },

          "family": {
            "type": "string",
            "enum": [
              "Dry Kibble","Wet Canned","Frozen Food","Freeze-Dried Food","Dehydrated Food",
              "Dry Food Toppings","Wet Food Toppings","Freeze-Dried/Dehydrated Toppings",
              "Training Treats","Jerky Treats","Freeze-Dried Treats","Dehydrated Treats",
              "Crunchy Treats","Lickable Treats","Catnip & Pet Grass",
              "Brush & Enzymatic Paste","VOHC Dental Chews","Supplements","OTC Meds","First Aid",
              "Calming Aids","Calming Refills","Recovery Collars & Apparel","At-Home Test Kits",
              "Flea Collars","Spot Treatments","Oral Treatments","Powders/Sprays/Wipes","Shampoos","Combs & Tick Removers",
              "Beds","Furniture","Doors","Pens","Harness & Leash",
              "Outdoor Apparel",
              "Shampoos & Conditioners","Sprays/Foams/Wipes","Creams & Rinses","Brushes & Combs","Grooming Tools",
              "Collars","ID Tags & Accessories",
              "Bowls & Diners","Feeders & Waterers","Placemats","Storage & Accessories","Filters (Feeding)","Pumps",
              "Litter","Litter Boxes","Mats","Liners","Waste Disposal","Filters (Litter)",
              "Cleaners & Stain Removers","Deodorizers",
              "Toys",
              "Repellents",
              "Prescription Food","Prescription Treats"
            ]
          },
          "rationale": { "type": "string" },
          "musts": { "type": "array", "items": { "type": "string" } },
          "nice_to_haves": { "type": "array", "items": { "type": "string" } },
          "negatives": { "type": "array", "items": { "type": "string" } },

          "embedding_query": { "type": "string", "maxLength": 300 },
          "bm25_query": { "type": "string","minLength": 1 },

          "filters": {
            "type": "object",
            "required": ["pc1"],
            "properties": {
              "pc1": { "type": "string" }
            },
            "additionalProperties": true
          },

          "top_k": { "type": "integer", "minimum": 10, "maximum": 200 },
          "brand_bias": { "type": "array", "items": { "type": "string" } },

          "evidence": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "additionalProperties": false
      }
    },

    "fusion": {
      "type": "object",
      "properties": {
        "strategy": { "type": "string", "enum": ["rrf", "weighted"] },
        "k": { "type": "integer" },
        "alpha_vector": { "type": "number" },
        "beta_bm25": { "type": "number" }
      },
      "required": ["strategy"]
    },

    "safety": {
      "type": "object",
      "properties": {
        "enforce_allergens": { "type": "boolean" },
        "species_lock": { "type": "boolean" }
      },
      "required": ["enforce_allergens", "species_lock"]
    }
  },
  "required": ["slots", "fusion", "safety"],
  "additionalProperties": false
}
